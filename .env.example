# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Django Configuration
DEBUG=False
SECRET_KEY=django-insecure-change-this-to-something-very-long-and-random-in-production
ENVIRONMENT=production
ALLOWED_HOSTS=ims-backend-e4fp.onrender.com,localhost,127.0.0.1

# Database Configuration
# Local Development: sqlite:///db.sqlite3
# Production: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://ims_user:password@localhost:5432/ims_db

# CORS Settings
CORS_ALLOWED_ORIGINS=https://ims-frontend-lilac-alpha.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://ims-frontend-lilac-alpha.vercel.app,http://localhost:5173

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Google Apps Script Email Configuration
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_API_KEY=your-secure-api-key

# JWT Token Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary Configuration (FREE - Recommended for image uploads)
# Get these from: https://cloudinary.com/console
# See IMAGE_STORAGE_SETUP.md for detailed instructions
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Security Settings (Production Only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# API Settings
API_TITLE=Inventory Management System
API_VERSION=1.0.0
DEFAULT_PAGE_SIZE=20

# Logging
LOG_LEVEL=INFO

# Other Settings
TIMEZONE=UTC
USE_I18N=True
